<Window x:Class="RekordboxMyTagSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="rekordbox MyTagSync"
        Icon="/assets/MyTagSync.ico"
        Height="820"
        Width="1280"
        MinHeight="700"
        MinWidth="1050">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="rekordbox MyTagSync"/>
            <TextBlock Margin="0,6,0,0"
                       Text="Safe foobar2000 metadata to rekordbox My Tag synchronization."/>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="OperationStatusTextBlock"
                       Grid.Row="0"
                       Margin="0,0,8,8"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Text="Ready — no database changes made."/>
            <ProgressBar x:Name="OperationProgressBar"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="12,0,0,8"
                         Width="160"
                         Height="12"
                         IsIndeterminate="True"
                         Visibility="Collapsed"/>
            <TextBlock x:Name="SettingsPathTextBlock"
                       Grid.Row="1"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="Settings: not loaded"/>
            <Button x:Name="SaveSettingsButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Padding="18,7"
                    Content="Save settings"/>
        </Grid>

        <TabControl>
            <TabItem Header="Source">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap"
                               Text="Select the foo_dj_library_bridge directory containing bridge-state.tsv and digital-items.tsv.gz."/>
                    <Grid Grid.Row="1" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BridgeDirectoryTextBox"
                                 VerticalContentAlignment="Center"
                                 MinHeight="30"/>
                        <Button x:Name="DiscoverSourceButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="14,6"
                                Content="Discover"/>
                        <Button x:Name="InspectSourceButton"
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Padding="14,6"
                                Content="Inspect"/>
                    </Grid>
                    <TextBlock x:Name="SourceInspectionStatusTextBlock"
                               Grid.Row="2"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Text="Source not yet inspected."/>
                    <DataGrid x:Name="SourceCandidatesGrid"
                              Grid.Row="3"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Directory" Binding="{Binding DirectoryPath}" Width="SizeToCells" MinWidth="500" MaxWidth="1100"/>
                            <DataGridCheckBoxColumn Header="Safe" Binding="{Binding Safe}" Width="70"/>
                            <DataGridCheckBoxColumn Header="Selected" Binding="{Binding Selected}" Width="80"/>
                            <DataGridTextColumn Header="Items" Binding="{Binding State.ItemCount}" Width="80"/>
                            <DataGridTextColumn Header="Schema" Binding="{Binding State.SchemaVersion}" Width="80"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding State.SourceName}" Width="140"/>
                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="240"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="4"
                               Margin="0,12,0,6"
                               FontWeight="SemiBold"
                               Text="Windows / SUBST path aliases"/>
                    <DataGrid x:Name="PathAliasGrid"
                              Grid.Row="5"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bridge/source root" Binding="{Binding SourceRoot}" Width="460"/>
                            <DataGridTextColumn Header="rekordbox/target root" Binding="{Binding TargetRoot}" Width="460"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="AddAliasButton" Padding="14,6" Content="Add alias"/>
                        <Button x:Name="RemoveAliasButton"
                                Margin="8,0,0,0"
                                Padding="14,6"
                                Content="Remove selected"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Target Library">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap"
                               Text="Discover rekordbox 6/7 libraries and select a safe master.db. Ambiguous discovery remains fail-closed."/>
                    <Grid Grid.Row="1" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetDatabaseTextBox"
                                 VerticalContentAlignment="Center"
                                 MinHeight="30"/>
                        <Button x:Name="DiscoverTargetButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="14,6"
                                Content="Discover"/>
                        <Button x:Name="BrowseTargetButton"
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Padding="14,6"
                                Content="Browse…"/>
                    </Grid>
                    <TextBlock x:Name="TargetDiscoveryStatusTextBlock"
                               Grid.Row="2"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Text="No target discovery performed yet."/>
                    <DataGrid x:Name="TargetCandidatesGrid"
                              Grid.Row="3"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Database" Binding="{Binding DatabasePath}" Width="SizeToCells" MinWidth="500" MaxWidth="1100"/>
                            <DataGridCheckBoxColumn Header="Safe" Binding="{Binding Safe}" Width="70"/>
                            <DataGridTextColumn Header="Used by" Binding="{Binding UsedBy.Count}" Width="80"/>
                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence.Count}" Width="80"/>
                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="260"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GroupBox Grid.Row="4" Margin="0,12,0,0" Header="Database access qualification">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Text="Resolve SQLCipher access automatically and qualify the selected rekordbox 6/7 database against the supported runtime schema. No database key is stored in settings or logs."/>
                            <Button x:Name="ValidateDatabaseAccessButton"
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Padding="14,6"
                                    Content="Validate access"/>
                            <TextBlock x:Name="DatabaseAccessStatusTextBlock"
                                       Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Text="Database access is not yet qualified."/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Path matching">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap"
                               Text="Each table row is ONE proposed mapping between entire folder roots, not one unmatched track. The source/target tracks shown are illustrative examples only. Proposed aliases remain UNVERIFIED until read-only file checks succeed; no aliases are applied or saved automatically."/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
                        <Button x:Name="AnalyzePathsButton"
                                Padding="16,7"
                                Content="Analyze paths (read-only)"
                                ToolTip="Compare inspected foobar and rekordbox paths without writing files, database rows, aliases or settings. Path similarities are never file identity proof."
                                ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="VerifyRootSampleButton"
                                Margin="8,0,0,0"
                                Padding="16,7"
                                Content="Check selected files (read-only)"
                                ToolTip="Read the selected proposed root mapping. Compare file sizes for all unambiguous physical pairs, then SHA-256 hash a small deterministic sample of file pairs up to 64 MiB each. No aliases or settings are changed; sampling never authorizes MyTag writes."
                                ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="VerifyPhysicalIdsButton"
                                Margin="8,0,0,0"
                                Padding="16,7"
                                Content="Check all file identities (read-only)"
                                ToolTip="Open each uniquely matched physical file pair with read-only Windows handles, then compare filesystem file IDs. Fast for mapped drives pointing at the same underlying files. Different file IDs do not mean different audio bytes; no alias is saved, and writing remains blocked."
                                ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="CancelPhysicalIdsButton"
                                Margin="8,0,0,0"
                                Padding="16,7"
                                IsEnabled="False"
                                Content="Cancel file check"
                                ToolTip="Stop the current read-only physical-file identity verification. No partial result authorizes any writes."
                                ToolTipService.ShowOnDisabled="True"/>
                    </StackPanel>
                    <TextBlock x:Name="PathAnalysisStatusTextBlock"
                               Grid.Row="2"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               Text="Path analysis not performed. Inspect Source and Validate target access first."/>
                    <TextBlock x:Name="PathVerificationStatusTextBlock"
                               Grid.Row="3"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"
                               Text="No file-content comparison performed. Select a proposed root mapping and choose Check selected files (read-only)."/>
                    <TextBlock x:Name="PhysicalIdentityStatusTextBlock"
                               Grid.Row="4"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"
                               Text="Entire mapping not checked against physical file IDs. No alias is approved."/>
                    <DataGrid x:Name="PathProposalsGrid"
                              Grid.Row="5"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Unverified source root" Binding="{Binding SourceRoot}" Width="SizeToCells" MinWidth="240" MaxWidth="800"/>
                            <DataGridTextColumn Header="Unverified target root" Binding="{Binding TargetRoot}" Width="SizeToCells" MinWidth="240" MaxWidth="800"/>
                            <DataGridTextColumn Header="Unique suffix pairs" Binding="{Binding UniqueSuffixPairs}" Width="140"/>
                            <DataGridTextColumn Header="Evidence — not file identity" Binding="{Binding Evidence}" Width="250"/>
                            <DataGridTextColumn Header="Illustrative source file" Binding="{Binding ExampleSource}" Width="SizeToCells" MinWidth="520" MaxWidth="1500"/>
                            <DataGridTextColumn Header="Illustrative target file" Binding="{Binding ExampleTarget}" Width="SizeToCells" MinWidth="520" MaxWidth="1500"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Mapping">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="MappingGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source tag" Binding="{Binding SourceField}" Width="130"/>
                            <DataGridTextColumn Header="MyTag group" Binding="{Binding TargetMyTag}" Width="130"/>
                            <DataGridTextColumn Header="Transform" Binding="{Binding Transform}" Width="115"/>
                            <DataGridCheckBoxColumn Header="Per value" Binding="{Binding PerValue}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Ignore empty" Binding="{Binding IgnoreEmpty}" Width="90"/>
                            <DataGridTextColumn Header="Prefix" Binding="{Binding Prefix}" Width="120"/>
                            <DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}" Width="540"/>
                            <DataGridTextColumn Header="Replacement" Binding="{Binding Replacement}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="AddMappingButton" Padding="14,6" Content="Add mapping"/>
                        <Button x:Name="RemoveMappingButton" Margin="8,0,0,0" Padding="14,6" Content="Remove selected"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Preview / Changes">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BuildPreviewButton" Padding="16,7" Content="Build fresh preview"
                                ToolTip="Compare the verified bridge and rekordbox tracks without writing files, settings or database rows. Every new preview invalidates the previous one."
                                ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="BuildVerifiedPreviewButton"
                                Margin="8,0,0,0"
                                Padding="16,7"
                                Content="Auto-match and preview (read-only)"
                                ToolTip="Automatically find one unambiguous source/target root candidate, recheck all physically identical file pairs with read-only Windows handles, show excluded ContentIDs, and preview MyTag changes. Never saves an alias or permits database writes."
                                ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="CancelVerifiedPreviewButton"
                                Margin="8,0,0,0"
                                Padding="12,7"
                                IsEnabled="False"
                                Content="Cancel"
                                ToolTip="Cancel the running read-only verified preview; no partial result is retained."/>
                        <TextBlock x:Name="PreviewStatusTextBlock"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="No approved preview."/>
                    </StackPanel>
                    <TextBlock x:Name="PreviewRunStatusTextBlock"
                               Grid.Row="1"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Text="No preview yet. Auto-match and preview checks physical file IDs again, uses the proven root only in memory, and shows excluded rekordbox tracks. Live writes stay locked."/>
                    <TextBlock x:Name="PreviewCountsTextBlock"
                               Grid.Row="2"
                               Margin="0,10,0,10"
                               Text="Add 0 · Remove 0 · Correct 0 · Conflicts 0 · Unmatched 0"/>
                    <TabControl Grid.Row="3" x:Name="PreviewResultsTabs">
                        <TabItem Header="MyTag changes / conflicts">
                            <DataGrid x:Name="PreviewGrid"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="100"/>
                                    <DataGridTextColumn Header="Content ID" Binding="{Binding ContentId}" Width="130"/>
                                    <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="680"/>
                                    <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="180"/>
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="540"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Investigate excluded tracks / MyTags">
                            <DockPanel Margin="4">
                                <TextBlock x:Name="PreviewInvestigationStatusTextBlock"
                                           DockPanel.Dock="Top"
                                           Margin="0,0,0,8"
                                           TextWrapping="Wrap"
                                           Text="Run Auto-match and preview to classify excluded rekordbox ContentIDs and duplicate MyTag link rows."/>
                                <DataGrid x:Name="PreviewInvestigationGrid"
                                          IsReadOnly="True"
                                          AutoGenerateColumns="False"
                                          FrozenColumnCount="2"
                                          CanUserSortColumns="True"
                                          CanUserResizeColumns="True"
                                          CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Reason" Binding="{Binding ReasonCode}" Width="220"/>
                                        <DataGridTextColumn Header="Content ID" Binding="{Binding ContentId}" Width="145">
                                            <!-- Visible separator for the two pinned columns;
                                                 keep theme colors and native selection behavior. -->
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="{x:Type DataGridCell}">
                                                    <Setter Property="BorderThickness" Value="0,0,2,0"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                            <DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                                    <Setter Property="BorderThickness" Value="0,0,2,0"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="650"/>
                                        <DataGridTextColumn Header="MyTag" Binding="{Binding MyTag}" Width="250"/>
                                        <DataGridTextColumn Header="Evidence / DB row IDs (read-only)" Binding="{Binding Details}" Width="950"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Physical exceptions (8)">
                            <DockPanel Margin="4">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="InvestigatePhysicalExceptionsButton"
                                                Padding="12,7"
                                                Content="Inspect physical exceptions (read-only)"
                                                ToolTip="Inspect only the duplicate rekordbox file paths and missing foobar-path matches, including existing track/playlist/cue/MyTag links. No full 40,000-track file-ID rescan and no database changes."/>
                                        <TextBlock x:Name="PhysicalExceptionsStatusTextBlock"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="Inspect Source and Validate Target first. No files or tags will be changed."/>
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="This identifies individual physical FILE references, not virtual CUE tracks. A pair of rekordbox ContentIDs at one path is not necessarily two audio files. Reference counts do not prove that a track is safe to delete."/>
                                </StackPanel>
                                <DataGrid x:Name="PhysicalExceptionsGrid"
                                          IsReadOnly="True"
                                          AutoGenerateColumns="False"
                                          CanUserResizeColumns="True"
                                          CanUserSortColumns="True"
                                          CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="210"/>
                                        <DataGridTextColumn Header="Content ID" Binding="{Binding ContentId}" Width="125"/>
                                        <DataGridTextColumn Header="Same-path ContentIDs" Binding="{Binding RelatedContentIds}" Width="200"/>
                                        <DataGridTextColumn Header="Rekordbox path" Binding="{Binding TargetPath}" Width="580"/>
                                        <DataGridTextColumn Header="Expected foobar path" Binding="{Binding ExpectedSourcePath}" Width="580"/>
                                        <DataGridTextColumn Header="Files on disk" Binding="{Binding DiskEvidence}" Width="500"/>
                                        <DataGridTextColumn Header="Bridge snapshot" Binding="{Binding BridgeEvidence}" Width="510"/>
                                        <DataGridTextColumn Header="Playlist refs" Binding="{Binding PlaylistReferences}" Width="105"/>
                                        <DataGridTextColumn Header="Cue refs" Binding="{Binding CueReferences}" Width="90"/>
                                        <DataGridTextColumn Header="MyTag refs" Binding="{Binding MyTagReferences}" Width="105"/>
                                        <DataGridTextColumn Header="Hot-cue bank refs" Binding="{Binding OtherDjReferences}" Width="130"/>
                                        <DataGridTextColumn Header="Conclusion" Binding="{Binding Conclusion}" Width="620"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="Apply / Restore">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap"
                               Text="Apply is enabled only for a fresh, conflict-free preview and uses the existing transactional executor. Restore uses only a validated rolling backup for the selected database."/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="ApplyButton"
                                Padding="18,8"
                                IsEnabled="False"
                                Content="Apply approved preview"/>
                        <Button x:Name="RestoreButton"
                                Margin="10,0,0,0"
                                Padding="18,8"
                                IsEnabled="False"
                                Content="Restore rolling backup"/>
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Backup package:"/>
                        <TextBox x:Name="BackupPackageTextBox"
                                 Grid.Column="1"
                                 Margin="10,0,0,0"
                                 IsReadOnly="True"/>
                    </Grid>
                    <TextBox x:Name="ApplyStatusTextBox"
                             Grid.Row="3"
                             Margin="0,14,0,0"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True"/>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostics / Logs">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="RefreshDiagnosticsButton"
                            HorizontalAlignment="Left"
                            Padding="16,7"
                            Content="Refresh diagnostics"/>
                    <TextBox x:Name="DiagnosticsTextBox"
                             Grid.Row="1"
                             Margin="0,12,0,0"
                             FontFamily="Consolas"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
